type Sponsor {
  """
  This virtual field will be resolved in one of the following ways (in this order):
   1. Execution of 'labelResolver' set on the Sponsor List config, or
   2. As an alias to the field set on 'labelField' in the Sponsor List config, or
   3. As an alias to a 'name' field on the Sponsor List (if one exists), or
   4. As an alias to the 'id' field on the Sponsor List.
  """
  _label_: String
  id: ID!
  title: String
  sortOrder: Int
  state: SponsorStateType
  topic: Topic
  url: String
  logo: Image
  mobile: Image
  tablet: Image
  updatedAt: DateTime
  createdAt: DateTime
  updatedBy: User
  createdBy: User
}

